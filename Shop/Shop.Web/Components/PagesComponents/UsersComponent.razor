<div class="products">
    @foreach (var item in Users)
    {
        <article class="product-card" style="--img:url('@*TODO: Photo*@')">
            <div class="product-body">
                <div class="product-top">
                    <h3 class="product-title">@item.Name</h3>
                    <div class="product-price">@item.Money грн</div>
                </div>
                <div class="product-meta">
                    <span class="badge">Email: @item.Email</span>
                </div>
            </div>
            <AuthorizeView Roles="God">
                <div class="product-actions">
                    <button class="pay-btn btn-manage"
                            type="button" @*
                            @onclick="OpenManageModal" *@>
                        Дать админку
                    </button>
                </div>
            </AuthorizeView>
            <AuthorizeView Roles="God,Admin">
            <div class="product-actions">
                <button class="pay-btn btn-delete"
                        type="button"@*
                        @onclick="OpenDeleteModal"*@>
                    Удалить
                </button>
            </div>
            </AuthorizeView>
        </article>
    }
</div>

<ShowMessageComponent IsShowMessage="_isShowMessage" IsSuccess="_isSuccess" MessageText="@_messageText" />