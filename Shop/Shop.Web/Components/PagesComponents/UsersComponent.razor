<div class="products">
    @foreach (var item in Users)
    {
        <article class="product-card" style="--img:url('img/users/users.jpg')">
            <div class="product-body">
                <div class="product-top">
                    <h3 class="product-title">@item.Name</h3>
                    <div class="product-price">@item.Money грн</div>
                </div>
                <div class="product-meta">
                    <span class="badge">@item.Email</span>
                </div>
            </div>
            <AuthorizeView Roles="God">
                <div class="product-actions">
                    <button class="pay-btn btn-manage"
                            type="button"
                            @onclick="() => OpenUserToAdminModal(item)">
                        Повысить
                    </button>
                </div>
            </AuthorizeView>
            <AuthorizeView Roles="God,Admin">
                <div class="product-actions">
                    <button class="pay-btn btn-delete"
                            type="button" 
                            @onclick="() => OpenDeleteUserModal(item)">
                        Удалить
                    </button>
                </div>
            </AuthorizeView>
        </article>
    }
</div>

<UserToAdminModalComponent IsUserToAdminOpen="_isUserToAdminOpen" User="_user" />
<DeleteUserModalComponent IsDeleteUserOpen="_isDeleteUserOpen" User="_user" />