<div class="wallet-page">
    <div class="wallet-card">
        <header class="wallet-header">
            <h1 class="wallet-title">Способы оплаты</h1>
            <p class="wallet-subtitle">Карта сохранена</p>
        </header>

        <section class="saved-card">
            <div class="saved-left">
                <div class="brand-pill">@Card.Brand.ToString()</div>
                <div class="saved-number">•••• •••• •••• @Number</div>
                <div class="saved-meta">Срок: @Card.ExpMonth.ToString("D2")/@Card.ExpYear · Имя: @Card.CardHolderName</div>
            </div>

            <div class="saved-right">
                <button class="danger-btn" type="button" @onclick="Remove">Удалить</button>
            </div>
        </section>

        <div class="divider"></div>

        <section class="topup">
            <h2 class="topup-title">Пополнить баланс</h2>

            <div class="topup-row">
                <label class="field grow">
                    <span class="label">Сумма</span>
                    <input class="input" type="number" min="1" step="1" placeholder="100" @bind-value="Deposit" />
                </label>

                <button class="primary-btn" type="button" @onclick="Replenish">Пополнить</button>
            </div>

            <p class="hint">Оплата картой, средства зачисляются на баланс пользователя.</p>
        </section>
    </div>
</div>

<ShowMessageComponent IsShowMessage="_isShowMessage" IsSuccess="_isSuccess" MessageText="@_messageText" />