@if (IsEditOpen && Product is not null)
{
    <div class="modal-backdrop" @onclick="CloseEditModal">
        <div class="modal-card modal-wide" @onclick:stopPropagation="true">
            <header class="modal-header">
                <h2 class="modal-title">Редактирование</h2>
            </header>
            <div class="modal-body">
                <EditForm class="form-grid" Model="ProductEditModel" OnValidSubmit="@SaveEditAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <div class="field">
                        <label class="label">
                            <span class="auth-label">Имя</span>
                            <InputText class="modal-input"
                                       type="text"
                                       autocomplete="name"
                                       id="name"
                                       @bind-Value="ProductEditModel.Name" />
                        </label>
                    </div>
                    <div class="field">
                        <label class="label" for="category">Категория</label>
                        <div class="select-wrap">
                            <InputSelect id="categoryId" @bind-Value="ProductEditModel.CategoryId" class="select">
                                @foreach (var category in Categories)
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            </InputSelect>
                            <span class="select-arrow"></span>
                        </div>
                    </div>
                    <div class="field">
                        <label class="label">
                            <span class="auth-label">Цена закупки</span>
                            <InputNumber class="modal-input"
                                       step="0.10"
                                       min="0"
                                       id="purchaseprice"
                                       @bind-Value="ProductEditModel.PurchasePrice" />
                        </label>
                    </div>
                    <div class="field">
                        <label class="label">
                            <span class="auth-label">Цена продажи</span>
                            <InputNumber class="modal-input"
                                         step="0.10"
                                         min="0"
                                         id="price"
                                         @bind-Value="ProductEditModel.Price" />
                        </label>
                    </div>
                    <div class="modal-actions">
                        <button class="pay-btn btn-save" type="submit">Сохранить</button>
                        <button class="btn modal-close-btn" type="button" @onclick="CloseEditModal">Отмена</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}
<ShowMessageComponent IsShowMessage="_isShowMessage" IsSuccess="_isSuccess" MessageText="@_messageText" />
