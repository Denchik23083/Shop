@page "/login"

<div class="auth-page">
    <div class="auth-card">
        <header class="auth-header">
            <h1 class="auth-title">Вход</h1>
            <p class="auth-subtitle">Войди, чтобы видеть корзину и оплачивать заказы</p>
        </header>

        <EditForm Model="LoginModel" OnValidSubmit="@Login" class="auth-form">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <label class="auth-field">
                <span class="auth-label">Email</span>
                <InputText class="auth-input"
                           type="email"
                           placeholder="name@example.com"
                           autocomplete="email"
                           id="email"
                           @bind-Value="LoginModel.Email" />
            </label>
            <label class="auth-field">
                <span class="auth-label">Пароль</span>
                <InputText class="auth-input"
                           type="password"
                           placeholder="••••••••"
                           autocomplete="new-password"
                           id="password"
                           @bind-Value="LoginModel.Password" />
            </label>

            <button class="auth-btn" type="submit">Войти</button>

            <div class="auth-hint">
                Нет аккаунта? <a class="auth-link" href="/register">Создать</a>
            </div>
        </EditForm>
    </div>
</div>

<ShowMessageComponent IsShowMessage="_isShowMessage" IsSuccess="_isSuccess" MessageText="@_messageText" />