@page "/register"

<div class="auth-page">
    <div class="auth-card">
        <header class="auth-header">
            <h1 class="auth-title">Регистрация</h1>
            <p class="auth-subtitle">Создай аккаунт — и можно собирать корзину</p>
        </header>

        <form class="auth-form">
            <label class="auth-field">
                <span class="auth-label">Имя</span>
                <input class="auth-input" type="text" placeholder="Денис" autocomplete="name" />
            </label>

            <label class="auth-field">
                <span class="auth-label">Email</span>
                <input class="auth-input" type="email" placeholder="name@example.com" autocomplete="email" />
            </label>

            <label class="auth-field">
                <span class="auth-label">Пароль</span>
                <input class="auth-input" type="password" placeholder="Минимум 6 символов" autocomplete="new-password" />
            </label>

            <label class="auth-field">
                <span class="auth-label">Повтори пароль</span>
                <input class="auth-input" type="password" placeholder="••••••••" autocomplete="new-password" />
            </label>

            <button class="auth-btn" type="button">Создать аккаунт</button>

            <div class="auth-hint">
                Уже есть аккаунт? <a class="auth-link" href="/login">Войти</a>
            </div>
        </form>
    </div>
</div>
