@page "/category/{CategoryId:int}"

<div class="category-header">
    <a class="back-link" href="/category">← Все категории</a>

    @if (_isLoading)
    {
        <p class="category-loading">Загрузка...</p>
    }
    else if (Category is null)
    {
        <p class="category-not-found">Категория не найдена</p>
    }
    else
    {
        <h2 class="category-name">@Category.Name</h2>
    }
</div>
@if (!_isLoading && Category is not null)
{
    <FilterProductsComponent Products="@Category.Products" />
}
