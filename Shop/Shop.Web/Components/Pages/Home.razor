@page "/"

<div class="products">
    @foreach (var item in Lists)
    {
        <article class="product-card">
            <div class="product-body">
              <div class="product-top">
                <h3 class="product-title">@item.Name</h3>
                <div class="product-price">@item.Price грн</div>
              </div>
              <div class="product-meta">
                <span class="badge">Срок до: @item.Expiration.ToString("dd/MM/yyyy")</span>
                <span class="badge badge-muted">В наличии: @item.Count</span>
              </div>
            </div>
            <div class="product-actions">
                <button class="btn-cart" type="button"
                        disabled="@(_addingProductId == item.Id)"
                        @onclick="() => InCartAsync(item.Id)">
                        @(_addingProductId == item.Id ? "Добавляю..." : "В корзину")
                </button>
            </div>
        </article>
    }
</div>

@if (_isShowMessage)
{
    <div class="cart-message @( _isSuccess ? "success" : "error" )">
        @_messageText
    </div>
}
