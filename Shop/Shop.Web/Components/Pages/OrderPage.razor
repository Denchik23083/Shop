@page "/order"
@attribute [Authorize]

@if (_isLoading)
{
    <p class="category-loading">Загрузка...</p>
}
else if (Order is null)
{
    <p class="category-not-found">Сделайте заказ</p>
}
else
{
    @if (Order.OrderProducts.Count == 0)
    {
        <div class="cart-page">
            <header class="cart-header">
                <h1 class="cart-title">В корзине пока пусто</h1>
            </header>
        </div>
    }
    else
    {
        <div class="cart-page">
            <header class="cart-header">
                <h1 class="cart-title">Корзина</h1>
                <p class="cart-subtitle">Проверь товары перед оплатой. Ваш заказ № @Order.Id</p>
            </header>

            <section class="cart-card">
                <div class="cart-table-wrap">
                    <table class="cart-table">
                        <thead>
                            <tr>
                                <th class="col-name">Товар</th>
                                <th class="col-stock">На складе</th>
                                <th class="col-unit">Цена</th>
                                <th class="col-qty">Кол-во</th>
                                <th class="col-total">Итого</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Order.OrderProducts)
                            {
                                @if (item.Product is not null)
                                {
                                    <tr>
                                        <td class="col-name">
                                            <div class="product-cell">
                                                <div class="product-name">@item.Product.Name</div>
                                                @if (item.Product.Category is not null)
                                                {
                                                    <div class="product-meta">Категория: @item.Product.Category.Name</div>
                                                }
                                            </div>
                                        </td>

                                        <td class="col-stock">
                                            <span class="stock-pill">@item.Product.Count</span>
                                        </td>

                                        <td class="col-unit">
                                            <span class="money">@item.UnitPrice грн</span>
                                        </td>

                                        <td class="col-qty">
                                            <div class="qty-control">
                                                <button class="qty-btn" type="button" aria-label="Уменьшить"
                                                    @onclick="() => DecreaseQuantityAsync(item.Product.Id)">−</button>
                                                <span class="qty-value">@item.Quantity</span>
                                                <button class="qty-btn" type="button" aria-label="Увеличить"
                                                    @onclick="() => IncreaseQuantityAsync(item.Product.Id)">+</button>
                                            </div>
                                            <div class="qty-hint">Доступно: @item.Product.Count</div>
                                        </td>

                                        <td class="col-total">
                                            <span class="money money-strong">@(item.UnitPrice* item.Quantity) грн</span>
                                            <button class="remove-link" type="button"
                                                    @onclick="() => RemoveProductFromOrderAsync(item.Product.Id)">Удалить </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <footer class="cart-footer">
                    <div class="cart-summary">
                        <div class="summary-row">
                            <span class="summary-label">Сумма</span>
                            <span class="summary-value">@Total грн</span>
                        </div>
                        <div class="summary-row summary-total">
                            <span class="summary-label">Итого к оплате</span>
                            <span class="summary-value">@Total грн</span>
                        </div>
                    </div>

                    <div class="cart-actions">
                        <button class="pay-btn" type="button"
                            @onclick="PayAsync">Оплатить</button>
                        <div class="pay-hint">Оплата наличными при получении</div>
                    </div>
                </footer>
            </section>
        </div>

        @if (_isShowMessage)
        {
            <div class="cart-message @( _isSuccess ? "success" : "error" )">
                @_messageText
            </div>
        }
    }
}
@if (_isShowMessage)
{
    <div class="cart-message @( _isSuccess ? "success" : "error" )">
        @_messageText
    </div>
}